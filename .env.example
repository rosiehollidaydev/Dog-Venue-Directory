# Copy this file to .env and fill in real values before running Docker.
# Never commit .env to version control.

# Required: minimum 32 random characters — generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-32-or-more-random-characters

# Required: strong password for the Postgres database
POSTGRES_PASSWORD=replace-with-strong-db-password

# Optional: host port to expose the app on (default: 3000)
APP_PORT=3000
